## Grid para mapear 5x5m

Um mapa com quadrados de 0.5m para posicionar novo mapeamento, com as árvores antigas como referência.
 
   
```{r, echo = TRUE, eval= FALSE }

## plot here
dev.new( width=15,height=15)
vptop<- viewport(y=0.9, width=0.8, height=0.2)
grid.text(x=0.5, y=0.9,"Parcela de Mapeamento 5m", vp= vptop, gp=gpar(fontsize = 20))
#upViewport()
vp <- viewport(width = 0.9, height = 0.9, xscale=c(0,5), yscale=c(0,5))
pushViewport(vp)
grid.rect(gp = gpar(col = "black"))
grid.xaxis(at=seq(0,5,by=1), gp=gpar(fontsize=15))
grid.yaxis(at=seq(0,5,by=1), gp=gpar(fontsize=15))
xseq = rep(seq(0.25,4.75,by=.5), each=10)
yseq = rep(seq(0.25,4.75,by=.5), 10)
loc_key = paste("quad_",xseq - 0.25, "x", yseq - 0.25, sep="")
#grid.rect(x = xseq,y= yseq, width=0.5, height=0.5, gp=gpar(fill=rgb(1,0,0,0.5)), default.units="native", name= loc_key)
## melhor colocar o nome em cada unidade para o id do xml ficar com o mesmo nome.
for(i in 1: length(loc_key))
{
    grid.rect(x = xseq[i],y= yseq[i], width=0.5, height=0.5, gp=gpar(fill=rgb(0,1,0,0.5)), default.units="native", name= loc_key[i])
}

#grid.circle(x= a00_0x0$dx,y=a00_0x0$dy, r= log(dbh0)/50, default.units="native", gp=gpar(fill=c(rgb(0,1,0, 0.5),rgb(1,0,0,0.5))[as.factor(a00_0x0$status=="A")], col="black"))
#grid.text(a00_0x0$tag, x= a00_0x0$dx+log(dbh0)/15 ,y=a00_0x0$dy+log(dbh0)/15,default.units="native")
## criando os dados em um csv para fazer correspondencia do ids no xml
# O ID DO retangulo colorido tem o final acrescido de .1.1 por conta da hierarquia dos elementos criados no  xml (use inkspace para acessar os dados do id)
locPos <- data.frame(loc_key= loc_key, xseq, yseq)
write.table(locPos, file="/home/aao/Ale2016/AleProjetos/PPPeic/censo2018/openDataKit/gridPos.csv", row.names=FALSE, sep= ",")
grid.export("/home/aao/Ale2016/AleProjetos/PPPeic/censo2018/openDataKit/gridMap0.svg", uniqueNames=FALSE)


```

